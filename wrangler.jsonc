// Cloudflare Workers(git 整合)部署設定。
// Build command  = npm run build(產出 dist/)
// Deploy command = npx wrangler deploy(把 dist 當 static assets 上傳)
// dist/_headers(來自 public/_headers)會被 Workers Static Assets 吃進去,
// CSP 等安全標頭照常生效。
// 資產優先:符合靜態資產的路徑直接出檔案,剩下的(/gcis/*)才進 worker.js
// —— 那是經濟部商工登記 API 的轉發(gcis 不給 CORS)。
{
  "name": "salary-thief",
  "compatibility_date": "2026-07-18",
  "main": "worker.js",
  "assets": {
    "directory": "./dist"
  }
}
